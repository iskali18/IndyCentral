---
import CategoryChips from "./CategoryChips.astro";
import type { SeriesGroupItem } from "../lib/types";

interface Props {
  item: SeriesGroupItem;
}
const { item } = Astro.props;
---
<li class="series-group">
  <div class="series-header">
    <div>
      <h3 class="series-title">{item.seriesName}</h3>
      {item.location && <p class="series-venue">{item.location}</p>}
    </div>
    <CategoryChips categories={item.categories} />
  </div>

  <ul class="series-legs" role="list">
    {item.legs.map((leg) => (
      <li class="series-leg" data-categories={leg.categories.join("|")}>
        <span class="leg-date">{leg.date.inlineLabel}</span>
        <span class="leg-title">{leg.title}</span>
        {leg.officialUrl && (
          <a class="leg-link" href={leg.officialUrl} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">Details →</span>
            <span class="sr-only">Details for {leg.title}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</li>

<style>
  .series-group {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-sub);
  }

  .series-group:last-child {
    border-bottom: none;
  }

  .series-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.9rem;
  }

  .series-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text);
    line-height: 1.15;
  }

  .series-venue {
    font-size: 0.88rem;
    color: var(--text-dim);
    margin-top: 0.3rem;
  }

  .series-legs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 0.1rem;
  }

  .series-leg {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.6rem;
    font-size: 0.92rem;
  }

  .series-leg::before {
    content: "•";
    color: var(--brand);
  }

  .leg-date {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .leg-title {
    color: var(--text);
    font-weight: 600;
    flex: 1;
    min-width: 12ch;
  }

  .leg-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .leg-link:hover {
    color: var(--accent-dim);
  }

  @media (max-width: 600px) {
    .series-leg {
      font-size: 0.88rem;
    }
  }
</style>
