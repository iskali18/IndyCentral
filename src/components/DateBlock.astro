---
interface Props {
  topLine: string;
  bottomLine: string;
}
const { topLine, bottomLine } = Astro.props;
---
<div class="date-block">
  {topLine && <span class="date-top">{topLine}</span>}
  <span class="date-bottom">{bottomLine}</span>
</div>

<style>
  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 84px;
    max-width: 110px;
    padding: 0.5rem 0.4rem;
    gap: 0.2rem;
    flex-shrink: 0;
    text-align: center;
  }

  .date-top {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand);
    text-transform: uppercase;
  }

  .date-bottom {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.05;
  }

  @media (max-width: 600px) {
    .date-block {
      min-width: 64px;
    }
    .date-bottom {
      font-size: 1.1rem;
    }
  }
</style>
