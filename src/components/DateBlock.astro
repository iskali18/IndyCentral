---
interface Props {
  bottomLine: string;
}
const { bottomLine } = Astro.props;
---
<div class="date-block">
  <span class="date-bottom">{bottomLine}</span>
</div>

<style>
  .date-block {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 84px;
    max-width: 110px;
    padding: 0.85rem 0.5rem;
    flex-shrink: 0;
    text-align: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-sub);
    border-radius: var(--radius);
  }

  .date-bottom {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.15;
  }

  @media (max-width: 600px) {
    .date-block {
      min-width: 68px;
      padding: 0.65rem 0.4rem;
    }
    .date-bottom {
      font-size: 1.3rem;
    }
  }
</style>
