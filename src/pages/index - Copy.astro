---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEvents } from "../lib/events";

const { events } = getEvents();

// ── Helpers ──────────────────────────────────────────────────────────────────
function parseDateDisplay(dateDisplay: string) {
  // dateDisplay format: "2026-03-15 18:30:00" or "2026-03-15" (no time)
  const parts = dateDisplay.split(" ");
  const datePart = parts[0];
  const timePart = parts[1] ?? "00:00:00";
  const [year, month, day] = datePart.split("-").map(Number);
  const [hour, min] = timePart.split(":").map(Number);

  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const weekdays = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  const d = new Date(year, month - 1, day);

  const ampm = hour >= 12 ? "PM" : "AM";
  const h12 = hour === 0 ? 12 : hour > 12 ? hour - 12 : hour;
  const hasTime = parts.length > 1;
  const timeStr = hasTime ? `${h12}:${String(min).padStart(2, "0")} ${ampm}` : "TBA";

  return {
    weekday:  weekdays[d.getDay()],
    monthDay: `${months[month - 1]} ${day}`,
    time:     timeStr,
    sortKey:  datePart,
    monthGroup: d.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
    dayNum:   String(day).padStart(2, "0"),
    monthAbbr: months[month - 1].toUpperCase(),
  };
}

// Filter to upcoming & sort
const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = events
  .map((e) => ({ ...e, _fmt: parseDateDisplay(e.dateDisplay) }))
  .filter((e) => new Date(e._fmt.sortKey + "T00:00:00") >= today)
  .sort((a, b) => a._fmt.sortKey.localeCompare(b._fmt.sortKey));

// Group by month
const grouped = upcoming.reduce<Record<string, typeof upcoming>>((acc, event) => {
  const key = event._fmt.monthGroup;
  if (!acc[key]) acc[key] = [];
  acc[key].push(event);
  return acc;
}, {});

const monthGroups = Object.entries(grouped);
---

<BaseLayout
  title="IndyCentral | Major Concerts in Indianapolis"
  description="See upcoming major concerts across the Indianapolis metro area in one place — all venues, sorted by date."
>

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Indianapolis Metro Area</p>
      <h1>Major Concerts,<br />One Place.</h1>
      <p class="subhead">
        Every big show coming to Indy — all venues, one feed, sorted by date.
        No bouncing between sites.
      </p>
      <a href="#concerts" class="hero-cta">Browse Upcoming Shows ↓</a>
    </div>
    <div class="hero-line" aria-hidden="true"></div>
  </section>

  <!-- ── CONCERTS ──────────────────────────────────────────────────────────── -->
  <section class="concerts" id="concerts">
    <div class="container">

      <div class="section-header">
        <h2>Upcoming Shows</h2>
        <span class="count">{upcoming.length} events</span>
      </div>

      {upcoming.length === 0 && (
        <p class="empty">No upcoming events found — check back soon.</p>
      )}

      {monthGroups.map(([month, events]) => (
        <div class="month-group">
          <div class="month-label">{month}</div>
          <ul class="event-list" role="list">
            {events.map((e) => (
              <li class="event-row">
                <div class="event-date">
                  <span class="date-month">{e._fmt.monthAbbr}</span>
                  <span class="date-day">{e._fmt.dayNum}</span>
                  <span class="date-wday">{e._fmt.weekday}</span>
                </div>

                <div class="event-info">
                  <a class="event-name" href={`/event/${e.slug}/`}>{e.name}</a>
                  <div class="event-meta">
                    <span class="event-venue">{e.venueName}</span>
                    <span class="event-sep" aria-hidden="true">·</span>
                    <span class="event-time">{e._fmt.time}</span>
                  </div>
                </div>

                <div class="event-actions">
                  <a
                    class="btn"
                    href={e.url}
                    target="_blank"
                    rel="nofollow noopener"
                    aria-label={`Get tickets for ${e.name}`}
                  >
                    Tickets
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>
  </section>

  <!-- ── ABOUT ─────────────────────────────────────────────────────────────── -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-inner">
        <h2>What is IndyCentral?</h2>
        <p>
          IndyCentral pulls together major concerts happening across the
          Indianapolis metro area — Gainbridge Fieldhouse, Ruoff Music Center,
          Old National Centre, and more — so you can see everything coming up
          without jumping between a dozen venue websites.
        </p>
        <p>
          Ticket links go directly to official listings. Data is updated
          automatically, so you're always looking at what's actually on sale.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="container">
      <span class="footer-logo">IndyCentral</span>
      <ul class="footer-notes">
        <li>Concert data updated automatically</li>
        <li>Ticket links go to official listings</li>
      </ul>
    </div>
  </footer>

</BaseLayout>

<style>
/* ── Hero ─────────────────────────────────────────────────────────────────── */
.hero {
  padding: 5rem 0 4rem;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 50% -10%, rgba(245,158,11,0.08) 0%, transparent 70%);
  pointer-events: none;
}

.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.hero h1 {
  font-family: var(--font-display);
  font-size: clamp(3rem, 9vw, 5.5rem);
  font-weight: 700;
  line-height: 1.0;
  letter-spacing: 0.01em;
  color: var(--text);
  margin-bottom: 1.25rem;
}

.subhead {
  font-size: 1.05rem;
  color: var(--text-dim);
  max-width: 440px;
  line-height: 1.65;
  margin-bottom: 2rem;
}

.hero-cta {
  display: inline-block;
  padding: 0.65em 1.5em;
  background: transparent;
  border: 1.5px solid var(--accent);
  color: var(--accent);
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-radius: var(--radius);
  transition: background 0.15s, color 0.15s;
}

.hero-cta:hover {
  background: var(--accent);
  color: #000;
}

.hero-line {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--border) 20%, var(--border) 80%, transparent 100%);
}

/* ── Concerts Section ─────────────────────────────────────────────────────── */
.concerts {
  padding: 4rem 0;
}

.section-header {
  display: flex;
  align-items: baseline;
  gap: 0.85rem;
  margin-bottom: 2.5rem;
}

.section-header h2 {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--text);
}

.count {
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--text-muted);
  letter-spacing: 0.03em;
}

.empty {
  color: var(--text-muted);
  font-size: 0.95rem;
  padding: 2rem 0;
}

/* ── Month Group ──────────────────────────────────────────────────────────── */
.month-group { margin-bottom: 2.5rem; }

.month-label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding-bottom: 0.6rem;
  margin-bottom: 0.25rem;
  border-bottom: 1px solid var(--border-sub);
}

/* ── Event List ───────────────────────────────────────────────────────────── */
.event-list {
  list-style: none;
}

.event-row {
  display: grid;
  grid-template-columns: 56px 1fr auto;
  align-items: center;
  gap: 1rem;
  padding: 0.9rem 0.75rem;
  border-bottom: 1px solid var(--border-sub);
  border-radius: var(--radius);
  transition: background 0.12s;
}

.event-row:last-child { border-bottom: none; }

.event-row:hover {
  background: var(--bg-elevated);
}

/* Date Badge */
.event-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
  gap: 1px;
  flex-shrink: 0;
}

.date-month {
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--accent);
}

.date-day {
  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.date-wday {
  font-size: 0.6rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

/* Event Info */
.event-info {
  min-width: 0;
}

.event-name {
  display: block;
  font-size: 0.975rem;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 0.2rem;
  transition: color 0.12s;
}

.event-row:hover .event-name { color: var(--accent); }

.event-meta {
  display: flex;
  align-items: center;
  gap: 0.4em;
  font-size: 0.8rem;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-venue { overflow: hidden; text-overflow: ellipsis; }
.event-sep   { flex-shrink: 0; opacity: 0.5; }
.event-time  { flex-shrink: 0; }

/* Actions */
.event-actions { flex-shrink: 0; }

/* ── About ────────────────────────────────────────────────────────────────── */
.about {
  padding: 4rem 0;
  border-top: 1px solid var(--border);
}

.about-inner {
  max-width: 560px;
}

.about h2 {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: 1.25rem;
}

.about p {
  font-size: 0.95rem;
  color: var(--text-dim);
  line-height: 1.75;
  margin-bottom: 0.85rem;
}

.about p:last-child { margin-bottom: 0; }

/* ── Footer ───────────────────────────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--border);
  padding: 2rem 0;
}

.site-footer .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.footer-logo {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.footer-notes {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
}

.footer-notes li {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.footer-notes li::before {
  content: '· ';
  color: var(--accent);
}

/* ── Mobile ───────────────────────────────────────────────────────────────── */
@media (max-width: 600px) {
  .hero { padding: 3.5rem 0 3rem; }

  .event-row {
    grid-template-columns: 48px 1fr auto;
    gap: 0.75rem;
    padding: 0.85rem 0.5rem;
  }

  .event-name  { font-size: 0.9rem; }
  .event-meta  { font-size: 0.75rem; }
  .date-day    { font-size: 1.35rem; }

  .btn {
    font-size: 0.72rem;
    padding: 0.4em 0.85em;
  }

  .site-footer .container {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
