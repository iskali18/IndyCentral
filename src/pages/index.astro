---
import BaseLayout from "../layouts/BaseLayout.astro";
import StandaloneEventRow from "../components/StandaloneEventRow.astro";
import SeriesGroupBlock from "../components/SeriesGroupBlock.astro";
import { getEventsData, homepagePreview } from "../lib/events";

const data = await getEventsData();
const preview = data.ok ? homepagePreview(data.flatSorted, 6) : [];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "IndyCentral",
  url: Astro.site?.toString(),
  description: "Curated events and things to do in Indianapolis and nearby.",
};
---
<BaseLayout
  title="IndyCentral | Indianapolis Events, Festivals & Things to Do"
  description="Discover curated concerts, festivals, and seasonal events happening in Indianapolis and nearby communities, all in one place."
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Indianapolis Events Guide</p>
      <h1>IndyCentral — Curated events and things to do in Indianapolis and nearby.</h1>
      <p class="subhead">
        From neighborhood festivals to major concerts, we bring together what's actually worth going to.
      </p>
      <a href="/events/" class="hero-cta">Explore Indianapolis Events →</a>
    </div>
    <div class="hero-line" aria-hidden="true"></div>
  </section>

  <section class="upcoming">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <a href="/events/" class="view-all">View All Events →</a>
      </div>

      {!data.ok && (
        <p class="empty">We're having trouble loading events right now. Please check back shortly.</p>
      )}

      {data.ok && preview.length === 0 && (
        <p class="empty">No events are currently listed — check back soon.</p>
      )}

      {data.ok && preview.length > 0 && (
        <ul class="event-list" role="list">
          {preview.map((item) =>
            item.kind === "standalone" ? (
              <StandaloneEventRow item={item} />
            ) : (
              <SeriesGroupBlock item={item} />
            )
          )}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5.5rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .eyebrow {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.005em;
    color: var(--text);
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }

  .subhead {
    font-size: 1.67rem;
    font-weight: 500;
    color: var(--text-dim);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 1.8rem;
  }

  .hero-cta {
    display: inline-block;
    padding: 0.8em 1.35em;
    background: transparent;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .hero-cta:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .upcoming {
    padding: 1rem 0 5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .section-header h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text);
  }

  .view-all {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .view-all:hover {
    color: var(--accent-dim);
  }

  .empty {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: 1.5rem 0;
  }

  .event-list {
    list-style: none;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 3.75rem 0 2.5rem;
    }
  }
</style>
