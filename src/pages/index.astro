---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventFilters from "../components/EventFilters.astro";
import EventList from "../components/EventList.astro";
import { getEventsData } from "../lib/events";
import { heroImage } from "../lib/editorialImages";

const data = await getEventsData();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Indianapolis Metro Events",
  url: Astro.site?.toString(),
  description:
    "Explore festivals, seasonal events, performances and distinctive experiences across Indianapolis and nearby communities.",
  isPartOf: {
    "@type": "WebSite",
    name: "IndyCentral",
    url: Astro.site?.toString(),
  },
};
---
<BaseLayout
  title="Indianapolis Metro Events | Festivals & Seasonal Attractions | IndyCentral"
  description="Explore festivals, seasonal events, performances and distinctive experiences across Indianapolis and nearby communities."
  structuredData={structuredData}
>
  <div class="page-watermark" aria-hidden="true"></div>

  <section class:list={["events-hero", { "has-photo": !!heroImage }]}>
    {heroImage && (
      <>
        <img
          class="hero-photo"
          src={heroImage.src}
          alt={heroImage.alt}
          loading="eager"
          fetchpriority="high"
          style={`object-position: ${heroImage.position ?? "center"};`}
        />
        <div class="hero-tint" aria-hidden="true"></div>
        {heroImage.caption && <p class="hero-caption">{heroImage.caption}</p>}
      </>
    )}
    <div class="container">
      <h1>Indianapolis Metro Events</h1>
      <p class="intro">
        IndyCentral features a curated lineup of regional festivals, shows, and community events in
        the Indianapolis area. Each listing is chosen based on its atmosphere, locale, and community
        reputation to help you decide where to spend your time.
      </p>
    </div>
  </section>

  <section class="events-list-section">
    <div class="container">
      {!data.ok && (
        <p class="empty">We're having trouble loading events right now. Please check back shortly.</p>
      )}

      {data.ok && data.flatSorted.length === 0 && (
        <p class="empty">No events are currently listed — check back soon.</p>
      )}

      {data.ok && data.flatSorted.length > 0 && (
        <>
          <EventFilters />
          <EventList monthGroups={data.monthGroups} />
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .events-hero {
    padding: 4.5rem 0 2.5rem;
  }

  .events-hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 62ch;
  }

  /* With a hero photo, the top of the page becomes a full-width band: the
     photo fills it, a tint keeps the text readable on any photo, and the
     heading and intro sit on top in white. */
  .events-hero.has-photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 27rem;
    padding: 4rem 0;
    background: var(--brand);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-tint {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(20, 36, 63, 0.84) 0%, rgba(20, 36, 63, 0) 80%),
      rgba(88, 114, 131, 0.35);
  }

  .events-hero.has-photo h1 {
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .events-hero.has-photo .intro {
    color: rgba(255, 255, 255, 0.93);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-caption {
    position: absolute;
    right: 1.5rem;
    bottom: 0.75rem;
    max-width: 45ch;
    text-align: right;
    font-size: 0.8rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.8);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }

  .events-hero.has-photo + .events-list-section {
    padding-top: 2.5rem;
  }

  .events-list-section {
    padding-bottom: 5rem;
  }

  /* A very faint gray-blue logo in the background, on the right side of
     the content area. Its right edge lines up with the right end of the
     divider lines. It is fixed to the window, so it stays still while the
     events scroll over it, and it is centered top to bottom in the window.
     The nav bar and hero band are solid and cover it. To make it stronger
     or fainter, change the opacity; to make it bigger or smaller, change
     the width. */
  .page-watermark {
    position: fixed;
    top: 50%;
    right: max(1.5rem, calc((100% - 1080px) / 2 + 1.5rem));
    width: min(440px, 45%);
    aspect-ratio: 1350 / 705;
    /* -50% centers the box. The extra 3.26% accounts for the logo file
       having more empty space above the letters than below. */
    transform: translateY(-53.26%);
    z-index: -1;
    pointer-events: none;
    /* The logo is used as a stencil: only its shape shows, filled with
       the gray-blue below. */
    background-color: #587283;
    -webkit-mask: url("/logo.webp") center / 100% 100% no-repeat;
    mask: url("/logo.webp") center / 100% 100% no-repeat;
    opacity: 0.07;
  }

  /* On a phone the text spans the whole width, so the tint is even instead
     of fading out toward the right. */
  @media (max-width: 700px) {
    .events-hero.has-photo {
      min-height: 22rem;
      padding: 3rem 0;
    }

    .hero-tint {
      background:
        linear-gradient(rgba(20, 36, 63, 0.68), rgba(20, 36, 63, 0.68)),
        rgba(88, 114, 131, 0.3);
    }
  }

  .empty {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: 1.5rem 0;
  }
</style>
