---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEvents } from "../lib/events";

const { events } = getEvents();

// ── Helpers ──────────────────────────────────────────────────────────────────
function parseDateDisplay(dateDisplay: string) {
  // dateDisplay format: "2026-03-15 18:30:00" or "2026-03-15" (no time)
  const parts = dateDisplay.split(" ");
  const datePart = parts[0];
  const timePart = parts[1] ?? "00:00:00";
  const [year, month, day] = datePart.split("-").map(Number);
  const [hour, min] = timePart.split(":").map(Number);

  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const d = new Date(year, month - 1, day);

  const ampm = hour >= 12 ? "PM" : "AM";
  const h12 = hour === 0 ? 12 : hour > 12 ? hour - 12 : hour;
  const hasTime = parts.length > 1;
  const timeStr = hasTime ? `${h12}:${String(min).padStart(2, "0")} ${ampm}` : "TBA";

  return {
    weekday: weekdays[d.getDay()],
    monthDay: `${months[month - 1]} ${day}`,
    time: timeStr,
    sortKey: datePart,
    monthGroup: d.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
    dayNum: String(day).padStart(2, "0"),
    monthAbbr: months[month - 1].toUpperCase(),
  };
}

// Filter to upcoming & sort
const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = events
  .map((e) => ({ ...e, _fmt: parseDateDisplay(e.dateDisplay) }))
  .filter((e) => new Date(e._fmt.sortKey + "T00:00:00") >= today)
  .sort((a, b) => a._fmt.sortKey.localeCompare(b._fmt.sortKey));

// Group by month
const grouped = upcoming.reduce<Record<string, typeof upcoming>>((acc, event) => {
  const key = event._fmt.monthGroup;
  if (!acc[key]) acc[key] = [];
  acc[key].push(event);
  return acc;
}, {});

const monthGroups = Object.entries(grouped);
---

<BaseLayout
  title="IndyCentral | Major Concerts in Indianapolis"
  description="See upcoming major concerts across the Indianapolis metro area in one place — all venues, sorted by date."
>
  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Indianapolis Concert Guide</p>
      <h1>Major concerts in Indianapolis, all in one place.</h1>
      <p class="subhead">
        Browse upcoming shows across major Indy-area venues in one clean, date-sorted list.
        No bouncing between venue websites.
      </p>

      <div class="hero-venues">
        <p class="hero-seo">
          IndyCentral tracks major concerts happening across the Indianapolis metro area.
          Shows are pulled from these venues:
        </p>

        <div class="venue-list">

          <div class="venue-row">
            <span class="venue-name">Gainbridge Fieldhouse</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Lucas Oil Stadium</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Ruoff Music Center</span>
            <span class="venue-city">— Noblesville</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Old National Centre</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">The Palladium</span>
            <span class="venue-city">— Carmel</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Clowes Memorial Hall</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Everwise Amphitheater at White River State Park</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Indiana Farmers Coliseum</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

          <div class="venue-row">
            <span class="venue-name">Hilbert Circle Theatre</span>
            <span class="venue-city">— Indianapolis</span>
          </div>

        </div>
      </div>

      <div class="hero-actions">
        <a href="#concerts" class="hero-cta">Browse upcoming shows</a>
      </div>

      <ul class="hero-points" role="list">
        <li>Major Indy-area venues</li>
        <li>Official ticket links</li>
        <li>Updated automatically</li>
      </ul>
    </div>
    <div class="hero-line" aria-hidden="true"></div>
  </section>

  <!-- ── CONCERTS ──────────────────────────────────────────────────────────── -->
  <section class="concerts" id="concerts">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-kicker">Upcoming concerts</p>
          <h2>What’s coming up</h2>
        </div>
        <span class="count">{upcoming.length} events</span>
      </div>

      {upcoming.length === 0 && (
        <p class="empty">No upcoming events found — check back soon.</p>
      )}

      {monthGroups.map(([month, events]) => (
        <div class="month-group">
          <div class="month-label">{month}</div>
          <div class="month-panel">
            <ul class="event-list" role="list">
              {events.map((e) => (
                <li class="event-row">
                  <div class="event-date">
                    <span class="date-month">{e._fmt.monthAbbr}</span>
                    <span class="date-day">{e._fmt.dayNum}</span>
                    <span class="date-wday">{e._fmt.weekday}</span>
                  </div>

                  <div class="event-info">
                    <a class="event-name" href={`/event/${e.slug}/`}>{e.name}</a>
                    <div class="event-meta">
                      <span class="event-venue">{e.venueName}</span>
                      <span class="event-sep" aria-hidden="true">·</span>
                      <span class="event-city">{e.city}, {e.state}</span>
                      <span class="event-sep" aria-hidden="true">·</span>
                      <span class="event-time">{e._fmt.time}</span>
                    </div>
                  </div>

                  <div class="event-actions">
                    <a
                      class="btn"
                      href={e.url}
                      target="_blank"
                      rel="nofollow noopener"
                      aria-label={`Get tickets for ${e.name}`}
                    >
                      Tickets
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── ABOUT ─────────────────────────────────────────────────────────────── -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-inner">
        <p class="section-kicker">About IndyCentral</p>
        <h2>Why IndyCentral exists</h2>
        <p>
          IndyCentral brings together major concerts happening across the Indianapolis metro area
          so you can see what’s coming up without checking each venue website individually.
        </p>
        <p>
          Listings are grouped in one place, sorted by date, and linked to official ticket pages.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="footer-logo">IndyCentral</span>
        <p class="footer-desc">Major Indianapolis-area concerts, gathered in one place.</p>
      </div>

      <ul class="footer-notes">
        <li>Concert data updated automatically</li>
        <li>Ticket links go to official listings</li>
      </ul>
    </div>
  </footer>
</BaseLayout>

<style>
/* ── Venue list overrides ─────────────────────────────────────────────────── */
:global(.venue-list) {
  padding-left: 1.25rem !important;
  margin-bottom: 3.5rem !important;
}

:global(.hero-venues),
:global(.hero-seo) {
  max-width: 560px !important;
}

/* ── Hero ─────────────────────────────────────────────────────────────────── */
.hero {
  padding: 6rem 0 4.5rem;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 50% -10%, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.eyebrow {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.hero h1 {
  font-family: var(--font-display);
  font-size: clamp(3.2rem, 8vw, 5.8rem);
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: 0.01em;
  color: var(--text);
  max-width: 11ch;
  margin-bottom: 1.25rem;
}

.subhead {
  font-size: 1.08rem;
  color: var(--text-dim);
  max-width: 560px;
  line-height: 1.7;
  margin-bottom: 1.8rem;
}

.hero-actions {
  margin-bottom: 1.4rem;
}

.hero-cta {
  display: inline-block;
  padding: 0.8em 1.35em;
  background: transparent;
  border: 1.5px solid var(--accent);
  color: var(--accent);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 999px;
  transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
}

.hero-cta:hover {
  background: var(--accent);
  color: #000;
  transform: translateY(-1px);
}

.hero-points {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem 1.25rem;
  color: var(--text-muted);
}

.hero-points li {
  position: relative;
  font-size: 0.82rem;
  padding-left: 0.9rem;
}

.hero-points li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55em;
  width: 0.35rem;
  height: 0.35rem;
  border-radius: 999px;
  background: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-glow);
}

.hero-line {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--border) 20%, var(--border) 80%, transparent 100%);
}

/* ── Shared Section Styles ────────────────────────────────────────────────── */
.section-kicker {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.5rem;
}

/* ── Concerts Section ─────────────────────────────────────────────────────── */
.concerts {
  padding: 4.5rem 0;
}

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.section-header h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--text);
  line-height: 1;
}

.count {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

.empty {
  color: var(--text-muted);
  font-size: 0.95rem;
  padding: 2rem 0;
}

/* ── Month Group ──────────────────────────────────────────────────────────── */
.month-group {
  margin-bottom: 2.75rem;
}

.month-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding-bottom: 0.75rem;
  margin-bottom: 0.7rem;
}

.month-panel {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.72) 0%, rgba(15, 23, 42, 0.42) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 0.35rem 0.75rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

/* ── Event List ───────────────────────────────────────────────────────────── */
.event-list {
  list-style: none;
}

.event-row {
  display: grid;
  grid-template-columns: 64px 1fr auto;
  align-items: center;
  gap: 1rem;
  padding: 1rem 0.75rem;
  border-bottom: 1px solid var(--border-sub);
  border-radius: 12px;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.event-row:last-child {
  border-bottom: none;
}

.event-row:hover {
  background: rgba(22, 32, 51, 0.72);
  transform: translateY(-1px);
}

/* Date Badge */
.event-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 64px;
  padding: 0.5rem 0.25rem;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(8, 12, 20, 0.72);
  line-height: 1;
  gap: 0.1rem;
  flex-shrink: 0;
}

.date-month {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--accent);
}

.date-day {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.date-wday {
  font-size: 0.62rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

/* Event Info */
.event-info {
  min-width: 0;
}

.event-name {
  display: block;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 0.28rem;
  transition: color 0.12s ease;
}

.event-row:hover .event-name {
  color: var(--accent);
}

.event-meta {
  display: flex;
  align-items: center;
  gap: 0.45em;
  font-size: 0.86rem;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-venue {
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-city {
  flex-shrink: 0;
  color: var(--text-muted);
}

.event-sep {
  flex-shrink: 0;
  opacity: 0.5;
}

.event-time {
  flex-shrink: 0;
}

/* Actions */
.event-actions {
  flex-shrink: 0;
}

/* ── About ────────────────────────────────────────────────────────────────── */
.about {
  padding: 5rem 0;
  border-top: 1px solid var(--border);
}

.about-inner {
  max-width: 760px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.72) 0%, rgba(15, 23, 42, 0.38) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
}

.about h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: 1.1rem;
  line-height: 1;
}

.about p {
  font-size: 0.98rem;
  color: var(--text-dim);
  line-height: 1.75;
  margin-bottom: 0.85rem;
}

.about p:last-child {
  margin-bottom: 0;
}

/* ── Footer ───────────────────────────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--border);
  padding: 2.25rem 0 2.75rem;
}

.footer-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.footer-brand {
  max-width: 320px;
}

.footer-logo {
  display: inline-block;
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
}

.footer-desc {
  margin-top: 0.35rem;
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.footer-notes {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
}

.footer-notes li {
  font-size: 0.78rem;
  color: var(--text-muted);
}

.footer-notes li::before {
  content: '· ';
  color: var(--accent);
}

/* ── Mobile ───────────────────────────────────────────────────────────────── */
@media (max-width: 720px) {
  .hero {
    padding: 4rem 0 3.25rem;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .month-panel {
    padding: 0.25rem 0.5rem;
  }

  .event-row {
    grid-template-columns: 52px 1fr;
    gap: 0.85rem;
    padding: 0.9rem 0.4rem;
  }

  .event-actions {
    grid-column: 2;
    justify-self: start;
    margin-top: 0.35rem;
  }

  .event-meta {
    white-space: normal;
    flex-wrap: wrap;
  }

  .date-day {
    font-size: 1.4rem;
  }

  .about-inner {
    padding: 1.35rem;
  }

  .site-footer {
    padding: 2rem 0 2.25rem;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .hero h1 {
    font-size: clamp(2.8rem, 13vw, 4rem);
  }

  .subhead {
    font-size: 1rem;
  }

  .hero-points {
    flex-direction: column;
    gap: 0.55rem;
  }

  .event-name {
    white-space: normal;
  }

  .btn {
    font-size: 0.74rem;
    padding: 0.48em 0.95em;
  }
}
</style>