---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEvents } from "../../lib/events";

export function getStaticPaths() {
  const data = getEvents();
  return data.events.map((e) => ({
    params: { slug: e.slug },
    props: { event: e }
  }));
}

const { event } = Astro.props;

// ── Helpers ──────────────────────────────────────────────────────────────────
function parseDateDisplay(dateDisplay: string) {
  const parts = dateDisplay.split(" ");
  const datePart = parts[0];
  const timePart = parts[1] ?? null;

  const [year, month, day] = datePart.split("-").map(Number);
  const d = new Date(year, month - 1, day);

  const fullDate = d.toLocaleDateString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric"
  });

  const shortDate = d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric"
  });

  let timeLabel = "Time TBA";

  if (timePart) {
    const [hour, min] = timePart.split(":").map(Number);
    const ampm = hour >= 12 ? "PM" : "AM";
    const h12 = hour === 0 ? 12 : hour > 12 ? hour - 12 : hour;
    timeLabel = `${h12}:${String(min).padStart(2, "0")} ${ampm}`;
  }

  return { fullDate, shortDate, timeLabel };
}

const fmt = parseDateDisplay(event.dateDisplay);

const title = `${event.name} – ${event.venueName}, ${event.city} | IndyCentral`;
const description = `${event.name} at ${event.venueName} in ${event.city}, ${event.state}. Date: ${event.dateDisplay}.`;

const venueLine = `${event.venueName}`;
const locationLine = `${event.city}, ${event.state}`;

const eventLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  "name": event.name,
  "startDate": event.dateLocal,
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": event.venueName,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": event.city,
      "addressRegion": event.state,
      "addressCountry": "US"
    }
  },
  "offers": {
    "@type": "Offer",
    "url": event.url,
    "availability": "https://schema.org/InStock"
  }
};

---

<BaseLayout title={title} description={description}>
  <section class="event-hero">
    <div class="container">
      <a href="/#concerts" class="back-link">← Back to all concerts</a>

      <div class="event-hero-grid">
        <div class="event-copy">
          <p class="eyebrow">Indianapolis Concert Listing</p>
            <h1>{headline}</h1>
          <p class="lede">
            {fmt.fullDate} at {event.venueName} in {event.city}, {event.state}.
          </p>
        </div>

        <aside class="ticket-panel">
          <p class="ticket-panel-label">Official listing</p>
          <a class="btn ticket-btn" href={event.url} target="_blank" rel="nofollow noopener">
            Get Tickets
          </a>
          <p class="ticket-note">Ticket link opens the official event listing in a new tab.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="event-details">
    <div class="container">
      <div class="detail-grid">
        <div class="detail-card">
          <p class="detail-label">Date</p>
          <p class="detail-value">{fmt.fullDate}</p>
        </div>

        <div class="detail-card">
          <p class="detail-label">Time</p>
          <p class="detail-value">{fmt.timeLabel}</p>
        </div>

        <div class="detail-card">
          <p class="detail-label">Venue</p>
          <p class="detail-value">{venueLine}</p>
        </div>

        <div class="detail-card">
          <p class="detail-label">Location</p>
          <p class="detail-value">{locationLine}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="event-about">
    <div class="container">
      <div class="about-panel">
        <p class="section-kicker">About this event</p>
        <h2>{event.name}</h2>
        <p>
          This concert is scheduled for {fmt.fullDate} at {event.venueName} in {event.city}, {event.state}.
          IndyCentral gathers major concerts happening across the Indianapolis metro area
          so you can see what’s coming up in one place and click through to the official ticket listing.
        </p>
        <p>
          Availability, pricing, and event details may change on the ticketing platform, so use the
          official listing for the most current information.
        </p>

        <div class="about-actions">
          <a class="btn" href={event.url} target="_blank" rel="nofollow noopener">View Official Tickets</a>
          <a class="secondary-link" href="/#concerts">Browse more upcoming concerts</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventLd)}></script>
</BaseLayout>

<style>
.event-hero {
  padding: 4.5rem 0 2.5rem;
  position: relative;
  overflow: hidden;
}

.event-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 50% -10%, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.back-link {
  display: inline-block;
  margin-bottom: 1.5rem;
  font-size: 0.86rem;
  color: var(--text-dim);
  transition: color 0.15s ease;
}

.back-link:hover {
  color: var(--text);
}

.event-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 2rem;
  align-items: start;
}

.eyebrow {
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.9rem;
}

.event-copy h1 {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 0.95;
  letter-spacing: 0.01em;
  margin-bottom: 1rem;
  max-width: 12ch;
}

.lede {
  max-width: 52ch;
  font-size: 1.02rem;
  line-height: 1.75;
  color: var(--text-dim);
}

.ticket-panel {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.78) 0%, rgba(15, 23, 42, 0.48) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
}

.ticket-panel-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.9rem;
}

.ticket-btn {
  width: 100%;
  justify-content: center;
  margin-bottom: 0.85rem;
}

.ticket-note {
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--text-muted);
}

.event-details {
  padding: 1rem 0 4rem;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
}

.detail-card {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.72) 0%, rgba(15, 23, 42, 0.42) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.15rem 1rem;
  min-height: 120px;
}

.detail-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 0.6rem;
}

.detail-value {
  font-size: 1rem;
  line-height: 1.55;
  color: var(--text);
  font-weight: 600;
}

.event-about {
  padding: 0 0 5rem;
}

.about-panel {
  max-width: 820px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.72) 0%, rgba(15, 23, 42, 0.38) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
}

.section-kicker {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.5rem;
}

.about-panel h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  margin-bottom: 1rem;
}

.about-panel p {
  font-size: 0.98rem;
  line-height: 1.75;
  color: var(--text-dim);
  margin-bottom: 0.9rem;
}

.about-panel p:last-of-type {
  margin-bottom: 0;
}

.about-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem 1rem;
  align-items: center;
  margin-top: 1.4rem;
}

.secondary-link {
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--text-dim);
  transition: color 0.15s ease;
}

.secondary-link:hover {
  color: var(--text);
}

@media (max-width: 900px) {
  .event-hero-grid {
    grid-template-columns: 1fr;
  }

  .ticket-panel {
    max-width: 380px;
  }

  .detail-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .event-hero {
    padding: 3.5rem 0 2rem;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }

  .about-panel {
    padding: 1.35rem;
  }

  .about-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .ticket-panel {
    max-width: none;
  }

  .ticket-btn {
    width: 100%;
  }
}
</style>