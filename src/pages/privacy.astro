---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy | IndyCentral";
const description = "Privacy Policy for IndyCentral.";
---

<BaseLayout title={title} description={description}>
  <section class="legal-page">
    <div class="container legal-container">

      <p class="legal-kicker">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="legal-updated">Effective Date: March 16, 2026</p>

      <div class="legal-content">

        <p>
          IndyCentral ("the Site", "we", "us", or "our") provides information about
          upcoming concerts in the Indianapolis metro area. This Privacy Policy
          explains how information may be collected and used when you visit the Site.
        </p>

        <h2>Information collected automatically</h2>

        <p>
          Like most websites, certain technical information may be collected automatically
          when you visit the Site. This may include information such as your browser type,
          device type, operating system, pages viewed, referring website, and approximate
          location based on IP address.
        </p>

        <p>
          This information is used only to understand how the Site is used and to improve
          the overall experience.
        </p>

        <h2>Cookies and similar technologies</h2>

        <p>
          The Site may use cookies or similar technologies for basic functionality and
          analytics. Cookies are small files stored on your device that help websites
          operate efficiently and understand visitor activity.
        </p>

        <p>
          You can manage or disable cookies through your browser settings. Disabling
          cookies may affect how some websites function.
        </p>

        <h2>Analytics</h2>

        <p>
          IndyCentral may use analytics tools to understand visitor behavior and improve
          site content and performance. These tools may collect aggregated information
          such as page visits, traffic sources, and general usage patterns.
        </p>

        <h2>Third-party links</h2>

        <p>
          The Site contains links to third-party websites, including official event and
          ticket provider pages. When you follow these links, you leave IndyCentral and
          are subject to the privacy policies of those third-party sites.
        </p>

        <p>
          IndyCentral is not responsible for the privacy practices or content of external
          websites.
        </p>

        <h2>Personal information</h2>

        <p>
          IndyCentral does not intentionally collect personal information from visitors
          during normal browsing of the Site.
        </p>

        <h2>Data use</h2>

        <p>
          Information collected through the Site may be used to operate the Site,
          understand visitor activity, improve content, and maintain the security
          and reliability of the platform.
        </p>

        <h2>Data security</h2>

        <p>
          Reasonable administrative and technical measures are used to help protect
          the Site and its systems. However, no method of internet transmission or
          electronic storage can be guaranteed to be completely secure.
        </p>

        <h2>Changes to this policy</h2>

        <p>
          This Privacy Policy may be updated from time to time. Any updates will be
          reflected on this page with a revised effective date.
        </p>

      </div>

    </div>
  </section>
</BaseLayout>

<style>
.legal-page {
  padding: 4.5rem 0 5rem;
}

.legal-container {
  max-width: 820px;
}

.legal-kicker {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.75rem;
}

.legal-page h1 {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 7vw, 4.5rem);
  line-height: 0.95;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  margin-bottom: 0.75rem;
}

.legal-updated {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 2rem;
}

.legal-content {
  background: linear-gradient(180deg, rgba(15,23,42,0.72) 0%, rgba(15,23,42,0.38) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
}

.legal-content h2 {
  font-family: var(--font-display);
  font-size: 1.45rem;
  text-transform: uppercase;
  margin: 1.7rem 0 0.6rem;
}

.legal-content h2:first-of-type {
  margin-top: 0;
}

.legal-content p {
  color: var(--text-dim);
  line-height: 1.8;
  margin-bottom: 0.9rem;
}
</style>